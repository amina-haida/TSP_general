fonction calcul_longueur (depart :str , arrivee:str , longueur, donnees : [str]Coordonnees, chemin [string], visites [string], Liste_chemin [[string]]) --> None

    if len(chemin) == longueur -1 :
        chemin.append(arrivee)
        Liste_chemin.append(chemin)
        return 
    
    elif len(chemin) == 0 :
        visitees.append(depart)
        chemin.append(depart)
        calcul_longueur(depart, arrivee, longueur, donnees, chemin , visitees , Liste_chemin)

    else : 
        for pays in donnees :
            if pays not in visites 
                chemin.append(pays )
                visitees.append(pays)
                calcul_longueur(depart, arrivee, longueur, donnees, chemin , visitees, Liste_chemin )
                chemin.pop()
                visitees.pop()


algorithme tsp1()--> chemin

