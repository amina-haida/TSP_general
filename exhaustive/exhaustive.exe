meilleur_cout = coût(Liste_chemin[0])
meilleur_chemin = Liste_chemin[0]
c := float

for chemin in Liste_chemin : 
    c = cout(chemin,donnees)
    if c < meilleur_cout : 
        meilleur_chemin= chemin
